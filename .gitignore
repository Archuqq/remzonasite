# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env: локальный .env не коммитим; .env.example — шаблон
.env
.env.local
.env.*.local
!.env.example

# данные экземпляра приложения
/data

# загруженные фото услуг
/uploads

# local database dumps
*.sql.gz

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
